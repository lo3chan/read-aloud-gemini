{
  "manifest_version": 3,

  "name": "__MSG_extension_name__",
  "short_name": "__MSG_extension_short_name__",
  "description": "__MSG_extension_description__",
  "version": "2.25.23",
  "default_locale": "en",
  "minimum_chrome_version": "99",

  "action": {
    "default_popup": "popup.html?isPopup=1"
  },
  "icons": {
    "16": "img/icon-16.png",
    "48": "img/icon-48.png",
    "128": "img/icon.png"
  },
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "scripting",
    "storage",
    "tts",
    "ttsEngine",
    "webRequest"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://texttospeech.googleapis.com/*",
    "https://cxl-services.appspot.com/*",
    "https://cloud.google.com/*",
    "https://www.gstatic.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*/*",
    "http://*/*",
    "wss://speech.platform.bing.com/*"
  ],
  "optional_host_permissions": [
    "http://*/",
    "https://*/",
    "file://*/*"
  ],
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "web_accessible_resources": [
    {
      "resources": [ "player.html", "sound/*", "img/*", "css/*" ],
      "matches": [ "<all_urls>" ],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "js/rxjs.umd.min.js",
      "js/defaults.js",
      "js/messaging.js",
      "js/content-handlers.js",
      "js/offscreen-manager.js",
      "js/reader-manager.js",
      "js/offscreen.js",
      "js/events.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "read-aloud-gemini@local",
      "strict_min_version": "121.0",
      "update_url": "https://raw.githubusercontent.com/lo3chan/read-aloud-gemini/main/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "play": {
      "suggested_key": {"default": "Alt+O"},
      "description": "Play/Stop"
    },
    "pause": {
      "suggested_key": {"default": "Alt+P"},
      "description": "Play/Pause"
    },
    "stop": {
      "description": "Stop"
    },
    "forward": {
      "suggested_key": {"default": "Alt+Period"},
      "description": "Forward"
    },
    "rewind": {
      "suggested_key": {"default": "Alt+Comma"},
      "description": "Rewind"
    }
  }
}
